# Configurações do Bot do Discord
DISCORD_BOT_TOKEN=

API_PORT=3000

# A URL do seu serviço interno de IA
AI_SERVICE_URL=
AI_SERVICE_API_KEY=

DATABASE_URL=
DIRECT_URL=
BACKEND_API_URL=http://localhost:3001

# Houston Bot Integration
INTERNAL_API_KEY=
INTERNAL_BOT_API_URL=http://localhost:3000

# RAG Reports Configuration
OPENAI_API_KEY=sk-...
REPORT_GUILD_ID=1234567890123456789
REPORT_FORUM_CHANNEL_ID=1234567890123456789
SIMILARITY_THRESHOLD=0.5
MAX_SIMILAR_REPORTS=10

# Celebrations module (birthdays + company anniversaries)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CELEBRATIONS_CHANNEL_ID=C0123ABC
IMAGE_GENERATOR_URL=https://image-generator-gold.vercel.app

# Slack bug-reports (RAG por threads no Slack — substitui o forum do Discord)
SLACK_SIGNING_SECRET=                 # https://api.slack.com/apps -> app -> Basic Information
SLACK_BUG_REPORTS_CHANNEL_ID=C0123ABC # canal no Slack onde o time abre bug reports

# Read-only DSN do banco da Skylab (usado pelo csat-reviews e por futuros
# módulos que precisem consultar dados da plataforma). Role tem que ser
# read-only no Postgres — o bot não emite escritas, mas garante por usuário.
SKYLAB_DATABASE_URL=postgres://...
